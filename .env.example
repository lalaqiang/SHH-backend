# 数据库配置
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_DATABASE=TestERP
DB_USER=sa
DB_PASSWORD=请修改为你的数据库密码

# JWT 密钥
JWT_SECRET=请修改为随机字符串（至少32字符）

# 服务器配置
HOST=0.0.0.0
PORT=8080

# CORS 允许的前端地址
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 日志配置
# 日志级别（默认 info），可选：error,warn,info,debug,trace 或具体模块如 erp_server=debug,tower_http=info
RUST_LOG=info
# 日志文件目录（不设置则只输出到 stdout；设置后按天滚动，文件名 erp-server.log.YYYY-MM-DD）
# 生产环境建议设置，例如：LOG_DIR=/var/log/erp-server
# LOG_DIR=./logs
